# Copy this file to ".env" and replace the placeholders.
# Never commit the real ".env" file.

# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=your-discord-bot-token

# Private test server and ticket category
TEST_GUILD_ID=123456789012345678
TICKET_CATEGORY_ID=123456789012345678

# Role of the support team (ignored by the bot, pinged for human help)
STAFF_ROLE_ID=123456789012345678

# Channel where star ratings are posted
FEEDBACK_CHANNEL_ID=123456789012345678

# Optional: ID of the Ticket Tool bot (default is the public Ticket Tool bot)
# TICKET_TOOL_BOT_ID=557628352828014614

# AI provider: "gemini" or "groq" (default: groq)
AI_PROVIDER=gemini

# API keys: only the key of the selected provider is needed
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
